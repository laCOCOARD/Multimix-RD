# Copia este archivo como .env y ajusta los valores.

# --- Django ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY='cambia-esta-clave'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Con esquema, separados por coma. Ej.: https://multimixrd.com,https://www.multimixrd.com
CSRF_TRUSTED_ORIGINS=
# Ruta del panel de administracion (sin barras). Cambiala en produccion.
ADMIN_URL=panel

# --- Base de datos ---
# DB_ENGINE: sqlite | postgresql | mysql
DB_ENGINE=sqlite
# sqlite: nombre del archivo. postgresql/mysql: nombre de la base.
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Fotos en Supabase Storage (opcional; local por defecto) ---
# Crea un bucket publico y copia estos datos desde Storage > S3 Connection.
MEDIA_STORAGE=local
SUPABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
